{
  "openapi": "3.0.1",
  "info": {
    "title": "默认模块",
    "description": "",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "s-match-controller"
    }
  ],
  "paths": {
    "/s-match": {
      "get": {
        "summary": "查询比赛列表",
        "deprecated": false,
        "description": "查询比赛列表.\n\n <p>\n 必传字段 gameDrawId\n <p>\n #2025-10-30新增入参字段\n 1.matchNoStartNumber 编号开始范围 ,数字类型 ,非必传\n 2.matchNoEndNumber  编号结束范围 ,数字类型 ,非必传\n 2026-5-15新增入参字段\n 1.gameType 查询游戏 1200足球 ,1270胜负 ,1260下半场比分 ,全部无需传\n\n\n <p>\n ```yaml\n errorCode:\n - 31: 服务异常\n # 字段验证\n - 2: 奖期ID不可为空\n - 2: 奖期不存在\n <p>\n ```",
        "operationId": "getSMatch",
        "tags": [
          "s-match-controller"
        ],
        "parameters": [
          {
            "name": "gameDrawId",
            "in": "query",
            "description": "奖期ID 自增",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "sportIdList",
            "in": "query",
            "description": "运动项目id",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            }
          },
          {
            "name": "matchNoStartNumber",
            "in": "query",
            "description": "编号开始范围",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "matchNoEndNumber",
            "in": "query",
            "description": "编号结束范围",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "matchStartTime",
            "in": "query",
            "description": "比赛开始时间",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "matchEndTime",
            "in": "query",
            "description": "比赛结束时间",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "gameType",
            "in": "query",
            "description": "查询游戏 -1200足球 ,1270胜负 ,1260下半场比分 ,全部无需传",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "game1200",
            "in": "query",
            "description": "足球单场游戏 , 是否查询足球单场 1是 0否 (前端不需要传)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "game1270",
            "in": "query",
            "description": "胜负过关  ,是否查询足球单场 1是 0否(前端不需要传)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "game1260",
            "in": "query",
            "description": "下半场比分  ,是否查询足球单场 1是 0否(前端不需要传)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "@CommonResult<List<SMatchResponse>> 比赛列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommonResultListSMatchResponse"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    }
  },
